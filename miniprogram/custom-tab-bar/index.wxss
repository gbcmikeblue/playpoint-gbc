.tb {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 200;
  background: #fff;
  box-shadow: var(--sh-bar, 0 -4rpx 20rpx rgba(0, 0, 0, 0.05));
  padding-bottom: env(safe-area-inset-bottom);
}
.tb__inner {
  height: 112rpx;
  display: flex;
  align-items: center;
  position: relative;
}
.tb__item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: relative;
  height: 100%;
}
.tb__icon {
  font-size: 40rpx;
  line-height: 1;
  opacity: 0.45;
  filter: grayscale(1);
}
.tb__icon.is-active {
  opacity: 1;
  filter: none;
}
.tb__text {
  font-size: 20rpx;
  margin-top: 6rpx;
  color: #9e9e9e;
}
.tb__text.is-active {
  color: #111;
  font-weight: 600;
}
.tb__fab {
  width: 88rpx;
  height: 88rpx;
  border-radius: 999rpx;
  background: var(--c-brand, #00e676);
  color: #111;
  font-size: 52rpx;
  line-height: 84rpx;
  text-align: center;
  position: absolute;
  top: -28rpx;
  box-shadow: var(--sh-fab, 0 8rpx 20rpx rgba(0, 230, 118, 0.45));
  border: 6rpx solid #fff;
}
.tb__badge {
  position: absolute;
  top: 16rpx;
  left: 50%;
  margin-left: 8rpx;
  min-width: 28rpx;
  height: 28rpx;
  line-height: 28rpx;
  padding: 0 6rpx;
  border-radius: 999rpx;
  background: #ff3b30;
  color: #fff;
  font-size: 18rpx;
  text-align: center;
}
