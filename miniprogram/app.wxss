@import 'styles/variables.wxss';
@import 'styles/mixins.wxss';

page {
  background: #ffffff;
  color: var(--c-text-1);
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Helvetica Neue', Helvetica, Arial,
    sans-serif;
  font-size: var(--fs-body);
  -webkit-font-smoothing: antialiased;
}

view,
text,
image,
scroll-view {
  box-sizing: border-box;
}

::-webkit-scrollbar {
  display: none;
  width: 0;
  height: 0;
}
