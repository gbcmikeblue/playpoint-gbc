<view
  class="nav nav--{{mode}} {{solid ? 'nav--solid' : ''}}"
  style="padding-top: {{statusBarHeight}}px; height: {{statusBarHeight + 44}}px;"
>
  <view class="nav__inner" style="height: 44px; padding-right: {{capsuleW}}px;">
    <view class="nav__left">
      <view wx:if="{{back}}" class="nav__back" bindtap="onBack" hover-class="nav__back--hover">
        <view class="chev"></view>
      </view>
      <slot name="left"></slot>
    </view>
    <view class="nav__title {{align === 'left' ? 'nav__title--left' : ''}}">{{title}}</view>
    <view class="nav__right">
      <slot name="right"></slot>
    </view>
  </view>
</view>
