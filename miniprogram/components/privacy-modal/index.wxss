.pm-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 999;
  display: flex;
  align-items: center;
  justify-content: center;
}
.pm-card {
  width: 620rpx;
  max-height: 70vh;
  background: #fff;
  border-radius: 32rpx;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}
.pm-title {
  text-align: center;
  font-size: 36rpx;
  font-weight: 700;
  padding: 48rpx 0 32rpx;
}
.pm-body {
  max-height: 46vh;
  padding: 0 40rpx;
}
.pm-p {
  font-size: 28rpx;
  line-height: 1.75;
  color: #333;
  margin-bottom: 20rpx;
}
.pm-link {
  color: #2f6bff;
}
.pm-foot {
  display: flex;
  border-top: 1rpx solid #eee;
  margin-top: 16rpx;
}
.pm-btn {
  flex: 1;
  height: 104rpx;
  line-height: 104rpx;
  text-align: center;
  font-size: 32rpx;
  font-weight: 600;
  color: #111;
}
.pm-btn--primary {
  background: var(--c-brand, #00e676);
}
