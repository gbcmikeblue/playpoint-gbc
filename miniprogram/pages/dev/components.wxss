.wrap {
  padding: 0 24rpx 80rpx;
  background: #fafafa;
  min-height: 100vh;
}
.sec {
  background: #fff;
  border-radius: 24rpx;
  padding: 24rpx;
  margin-top: 24rpx;
}
.sec__title {
  font-size: 28rpx;
  font-weight: 700;
  margin-bottom: 20rpx;
}

.swatches {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.sw {
  width: 150rpx;
}
.sw__box {
  height: 80rpx;
  border-radius: 12rpx;
  border: 1rpx solid rgba(0, 0, 0, 0.05);
}
.sw__name {
  font-size: 20rpx;
  color: #333;
  margin-top: 6rpx;
}
.sw__v {
  font-size: 18rpx;
  color: #999;
}

.type {
  margin-bottom: 16rpx;
  color: #111;
}

.demo-line {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.chip {
  height: 56rpx;
  line-height: 56rpx;
  padding: 0 24rpx;
  border-radius: 999rpx;
  background: #f7f7f7;
  font-size: 24rpx;
  color: #333;
}
.chip--active {
  background: var(--c-brand);
  font-weight: 600;
  color: #111;
}

.demo-card {
  display: flex;
  padding: 20rpx;
  border-radius: 24rpx;
  box-shadow: var(--sh-card);
}
.demo-card__cover {
  width: 240rpx;
  height: 180rpx;
  border-radius: 20rpx;
  background: #eef9f1;
  flex-shrink: 0;
}
.demo-card__body {
  margin-left: 20rpx;
  flex: 1;
}
.demo-card__d {
  font-size: 34rpx;
  font-weight: 700;
}
.demo-card__today {
  font-size: 18rpx;
  background: var(--c-brand-weak);
  color: #0a7d46;
  padding: 2rpx 8rpx;
  border-radius: 6rpx;
  margin-left: 8rpx;
}
.demo-card__t {
  font-size: 30rpx;
  font-weight: 600;
  margin-top: 8rpx;
}
.demo-card__loc {
  font-size: 24rpx;
  color: #999;
  margin-top: 12rpx;
}

.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx 0;
}
.empty__art {
  font-size: 96rpx;
}
.empty__title {
  font-size: 30rpx;
  font-weight: 600;
  margin-top: 16rpx;
}
.empty__desc {
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
}

.sk {
  display: flex;
  padding: 20rpx;
  border-radius: 24rpx;
  background: #fff;
  box-shadow: var(--sh-card);
  margin-top: 16rpx;
}
.sk__cover {
  width: 240rpx;
  height: 180rpx;
  border-radius: 20rpx;
  background: #f0f0f0;
  animation: breath 1.2s ease-in-out infinite;
}
.sk__lines {
  flex: 1;
  margin-left: 20rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  padding-top: 8rpx;
}
.sk__line {
  height: 28rpx;
  border-radius: 8rpx;
  background: #f0f0f0;
  animation: breath 1.2s ease-in-out infinite;
}
@keyframes breath {
  0%,
  100% {
    opacity: 1;
  }
  50% {
    opacity: 0.45;
  }
}

.foot {
  text-align: center;
  font-size: 22rpx;
  color: #bbb;
  margin-top: 40rpx;
}
