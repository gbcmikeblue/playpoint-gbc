<view class="page">
  <nav-bar title="票夹" />

  <view class="tabs" style="top: {{statusBarHeight + 44}}px;">
    <view class="tabs__item {{tab === 0 ? 'is-active' : ''}}" data-i="0" bindtap="onTab">全部</view>
    <view class="tabs__item {{tab === 1 ? 'is-active' : ''}}" data-i="1" bindtap="onTab">待验票</view>
  </view>

  <view class="list" style="padding-top: {{statusBarHeight + 44 + 44}}px;">
    <view wx:if="{{loading}}" class="state">加载中…</view>
    <view wx:elif="{{error}}" class="state" bindtap="onRetry">加载失败，点击重试</view>

    <block wx:elif="{{list.length}}">
      <view wx:for="{{list}}" wx:key="id" class="tk" data-id="{{item.id}}" bindtap="onOpen">
        <view class="tk__left">
          <view class="tk__title ellipsis-2">{{item.title}}</view>
          <view class="tk__row" wx:if="{{item.poiName}}">📍 {{item.poiName}}</view>
          <view class="tk__row" wx:if="{{item.sessionText}}">🕐 {{item.sessionText}}</view>
          <view class="tk__row">💚 {{item.guaranteeText}}</view>
          <view class="tk__btn" data-id="{{item.id}}" catchtap="onVerify">我要验票</view>
        </view>

        <view class="tk__dash"></view>

        <view class="tk__right">
          <view class="tk__status">{{item.statusText}}</view>
          <view class="tk__seal">
            <text class="tk__seal-main">{{item.sealText}}</text>
            <text class="tk__seal-sub">PLAYPOINT</text>
          </view>
          <view class="tk__more" data-id="{{item.id}}" catchtap="onMore">更多</view>
        </view>
      </view>

      <view class="brand">
        <text class="brand__logo">玩点</text>
        <text class="brand__slogan">- 玩点，一起去玩 -</text>
      </view>
    </block>

    <view wx:else class="empty">
      <view class="empty__icon">🎫</view>
      <view class="empty__text">票夹还是空的</view>
      <view class="empty__btn" bindtap="onHome">去首页看看</view>
    </view>
  </view>
</view>
