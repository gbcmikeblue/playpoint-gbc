.page {
  min-height: 100vh;
  background: var(--c-fill);
}

.tabs {
  position: fixed;
  left: 0;
  right: 0;
  height: 88rpx;
  display: flex;
  align-items: center;
  padding: 0 var(--sp-3);
  background: #fff;
  z-index: 5;
}

.tabs__item {
  margin-right: 40rpx;
  font-size: 28rpx;
  color: var(--c-text-3);
  position: relative;
  height: 88rpx;
  line-height: 88rpx;
}

.tabs__item.is-active {
  color: var(--c-text-1);
  font-weight: 700;
}

.tabs__item.is-active::after {
  content: '';
  position: absolute;
  left: 50%;
  bottom: 14rpx;
  width: 40rpx;
  height: 6rpx;
  margin-left: -20rpx;
  border-radius: var(--r-full);
  background: var(--c-brand);
}

.list {
  padding: 20rpx var(--sp-3) 60rpx;
}

.state {
  padding-top: 160rpx;
  text-align: center;
  color: var(--c-text-3);
  font-size: 26rpx;
}

.tk {
  display: flex;
  margin-bottom: 24rpx;
  padding: 24rpx;
  border-radius: var(--r-lg);
  background: linear-gradient(135deg, #e8fbf0 0%, #ffffff 62%);
  box-shadow: var(--sh-card);
}

.tk__left {
  flex: 1;
  min-width: 0;
}

.tk__title {
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.4;
}

.tk__row {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: var(--c-text-2);
}

.tk__btn {
  display: inline-block;
  margin-top: 18rpx;
  height: 60rpx;
  line-height: 60rpx;
  padding: 0 28rpx;
  border-radius: var(--r-full);
  background: #0d0d0d;
  color: #fff;
  font-size: 24rpx;
}

.tk__dash {
  width: 0;
  margin: 0 20rpx;
  border-left: 2rpx dashed #d8e8de;
}

.tk__right {
  width: 170rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.tk__status {
  font-size: 20rpx;
  color: var(--c-brand-strong);
}

.tk__seal {
  width: 132rpx;
  height: 132rpx;
  margin-top: 10rpx;
  border: 3rpx solid #7fd7b0;
  border-radius: 50%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #2f9e6f;
}

.tk__seal-main {
  font-size: 22rpx;
  font-weight: 700;
}

.tk__seal-sub {
  margin-top: 4rpx;
  font-size: 14rpx;
  letter-spacing: 1rpx;
}

.tk__more {
  margin-top: 14rpx;
  height: 52rpx;
  line-height: 52rpx;
  padding: 0 26rpx;
  border-radius: var(--r-full);
  background: var(--c-brand);
  color: #111;
  font-size: 22rpx;
}

.brand {
  padding: 40rpx 0 20rpx;
  text-align: center;
}

.brand__logo {
  display: block;
  font-size: 30rpx;
  font-weight: 800;
}

.brand__slogan {
  display: block;
  margin-top: 8rpx;
  font-size: 20rpx;
  color: var(--c-text-4);
}

.empty {
  padding-top: 180rpx;
  text-align: center;
}

.empty__icon {
  font-size: 88rpx;
}

.empty__text {
  margin-top: 20rpx;
  font-size: 26rpx;
  color: var(--c-text-3);
}

.empty__btn {
  display: inline-block;
  margin-top: 32rpx;
  height: 76rpx;
  line-height: 76rpx;
  padding: 0 48rpx;
  border-radius: var(--r-full);
  background: var(--c-brand);
  color: #111;
  font-size: 26rpx;
  font-weight: 600;
}
