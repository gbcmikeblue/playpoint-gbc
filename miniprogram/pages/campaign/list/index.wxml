<view class="page">
  <view class="hero" style="padding-top: {{statusBarHeight}}px;">
    <view class="hero__row">
      <view class="hero__back" bindtap="noop"></view>
      <view class="hero__msg" bindtap="noop">💬</view>
    </view>
    <view class="hero__inner">
      <view class="hero__title">一起去挑战</view>
      <view class="hero__sub">打卡城市点位，集限定奖牌</view>
      <view class="hero__deco">🏔️ 🏅 🧭</view>
    </view>
  </view>

  <view class="list">
    <view
      wx:for="{{list}}"
      wx:key="id"
      class="cc"
      data-id="{{item.id}}"
      bindtap="onOpen"
      hover-class="cc--hover"
    >
      <view class="cc__head">
        <image class="cc__seal" src="{{item.sealUrl}}" mode="aspectFill" />
        <view class="cc__headinfo">
          <view class="cc__title ellipsis">{{item.title}}</view>
          <view class="cc__date">{{item.dateText}}</view>
        </view>
      </view>

      <view class="cc__imgs">
        <image
          wx:for="{{item.images}}"
          wx:for-item="img"
          wx:key="*this"
          class="cc__img"
          src="{{img}}"
          mode="aspectFill"
          lazy-load
        />
      </view>

      <view class="cc__foot">
        <view class="cc__people">
          <view class="cc__avatar"></view>
          <view class="cc__avatar cc__avatar--2"></view>
          <view class="cc__avatar cc__avatar--3"></view>
          <text class="cc__hint">{{item.medalHint}}</text>
        </view>
        <view class="cc__btn" data-id="{{item.id}}" catchtap="onCheckin">
          <text class="cc__going">GOING</text>
          <text>{{item.actionText}}</text>
        </view>
      </view>
    </view>

    <view wx:if="{{loading}}" class="tip">加载中…</view>
    <view wx:elif="{{error}}" class="tip" bindtap="load">加载失败，点击重试</view>
    <view wx:elif="{{!list.length}}" class="tip">还没有进行中的挑战赛</view>
  </view>
</view>
